#include <iostream>
#include <vector>
using namespace std;
int main() {
	ios::sync_with_stdio(false);
	cin.tie(nullptr);

	int n;
	cin >> n;

	vector<int> cnt(20002, 0);

	for (int i = 0; i < n; i++)
	{
		int input;
		cin >> input;

		cnt[input] = 1;
	}

	for (int i = 0; i < 20001; i++)
	{
		if (cnt[i] != 1)
			continue;
		cout << i << ' ';
	}

	
	return 0;
}